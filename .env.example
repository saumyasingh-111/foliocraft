# Firebase Client Configuration
# Obtain these from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public Application Base URL
# In local development: http://localhost:3000
# In production on Vercel: https://foliocraft-jade.vercel.app (or custom domain: https://yourdomain.com)
NEXT_PUBLIC_APP_URL=https://foliocraft-jade.vercel.app

# Base Platform Domain for Multi-Tenant Wildcard Routing
# In local development: localhost:3000
# In production: foliocraft-jade.vercel.app (or yourdomain.com)
NEXT_PUBLIC_APP_DOMAIN=foliocraft-jade.vercel.app
