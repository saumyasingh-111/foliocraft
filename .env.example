# Firebase Client Configuration
# Obtain these from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base Platform Domain for Multi-Tenant Wildcard Routing
# In local development: localhost:3000
# In production: yourdomain.com
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
