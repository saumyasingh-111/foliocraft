rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Scoped user portfolio uploads:
    // users/{userId}/portfolios/{portfolioId}/{category}/{fileName}
    match /users/{userId}/portfolios/{portfolioId}/{category}/{fileName} {
      
      // Public read access for portfolio images, avatars, and downloadable resumes
      allow read: if true;

      // Write / Delete restricted strictly to authenticated owner of that directory
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (
                     (category == "resumes" 
                       && request.resource.size <= 10 * 1024 * 1024 
                       && request.resource.contentType == 'application/pdf')
                     || 
                     (category != "resumes" 
                       && request.resource.size <= 5 * 1024 * 1024 
                       && request.resource.contentType.matches('image/.*'))
                   );

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
