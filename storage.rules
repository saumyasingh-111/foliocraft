rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Scoped user uploads:
    // Supports users/{userId}/{category}/{fileName}
    // and users/{userId}/portfolios/{portfolioId}/{category}/{fileName}
    match /users/{userId}/{allPaths=**} {
      
      // Public read access for portfolio images, avatars, and downloadable resumes
      allow read: if true;

      // Write restricted strictly to authenticated owner of that directory
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType == 'application/pdf' 
                       && request.resource.size <= 10 * 1024 * 1024)
                     || 
                     (request.resource.contentType.matches('image/.*') 
                       && request.resource.size <= 5 * 1024 * 1024)
                   );

      // Deletion restricted strictly to authenticated owner of that directory
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
