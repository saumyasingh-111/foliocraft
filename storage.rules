rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User portfolio media folder
    match /users/{userId}/portfolios/{portfolioId}/{category}/{fileName} {
      // Public read access for images and resumes
      allow read: if true;

      // Write, update, delete only by the authenticated owner
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (
                     (category == "resumes" && request.resource.size < 10 * 1024 * 1024)
                     || (category != "resumes" && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
                   );
    }
  }
}
