rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: Private to owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Usernames collection: Unique slug reservations
    match /usernames/{username} {
      // Anyone can check if a slug is taken
      allow read: if true;
      // Write allowed if authenticated and setting for own portfolio
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Portfolios collection: Multi-tenant portfolios
    match /portfolios/{portfolioId} {
      // Public read if published; owner read if draft
      allow read: if resource.data.isPublished == true || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // Create if authenticated
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Update and delete strictly restricted to owner
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
